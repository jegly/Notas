+/// Inside a strict snap Notas can't own its D-Bus name (that needs a dbus slot,
+/// which the Snap Store holds for manual review), so GApplication's
+/// single-instance guarantee is gone. Recreate it with an exclusive lock in the
+/// data dir — a second copy would otherwise load, then overwrite, the first
+/// one's notes. Returns false if another instance already holds the lock.
+fn acquire_snap_instance_lock() -> bool {
+    use std::os::unix::io::AsRawFd;
+    let Some(dir) = dirs::data_dir().map(|d| d.join("notas")) else { return true };
+    if std::fs::create_dir_all(&dir).is_err() {
+        return true;
+    }
+    let Ok(file) = std::fs::OpenOptions::new()
+        .create(true)
+        .write(true)
+        .open(dir.join("instance.lock"))
+    else {
+        return true;
+    };
+    if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+        return false;
+    }
+    // Held for the life of the process; the kernel drops it with the fd.
+    std::mem::forget(file);
+    true
+}
+
